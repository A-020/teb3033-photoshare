{
  "info": {
    "name": "PhotoShare API (TEB3033)",
    "description": "One request per endpoint in Appendix A of the implementation guide.\n\nRun order: Health, Auth (Login saves the token), Groups, Photos, Comments, Cleanup.\nProtected requests inherit Bearer {{token}} from the collection. Health, Register and Login use no auth.\n\nFor the deployed server, change baseUrl to http://<EC2 address>/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "username",
      "value": "alice"
    },
    {
      "key": "email",
      "value": "alice@test.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "friendUsername",
      "value": "bob"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database connected', () => pm.expect(pm.response.json().db).to.eql('connected'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns 201 for a new user. Returns 409 if the username or email already exists, which is also accepted here so the collection can be re-run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "pm.test('No password_hash in response', () => pm.expect(pm.response.text()).to.not.include('password_hash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saves the returned JWT into the collection variable \"token\". Every protected request uses it through the collection-level Bearer auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns a token', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.test('No password_hash in user', () => pm.expect(json.user).to.not.have.property('password_hash'));",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the logged-in user', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Trip\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates the group and adds the creator as a member in one transaction. Saves the new id into \"groupId\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('groupId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Includes member_count', () => pm.expect(pm.response.json()[0]).to.have.property('member_count'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                "{{groupId}}",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add friend",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                "{{groupId}}",
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{friendUsername}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns 201 when added and 200 if already a member (INSERT IGNORE). The friend account must already exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Photos",
      "item": [
        {
          "name": "Upload photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": [],
                  "description": "Select a JPEG, PNG or WebP file (max 5 MB)"
                },
                {
                  "key": "groupId",
                  "value": "{{groupId}}",
                  "type": "text"
                },
                {
                  "key": "caption",
                  "value": "Uploaded from Postman",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "postman, sunset",
                  "type": "text"
                }
              ]
            },
            "description": "Before running, open the Body tab and choose a file for the \"photo\" field. Saves the new id into \"photoId\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has a pre-signed URL', () => pm.expect(json.url).to.include('X-Amz-Signature'));",
                  "pm.collectionVariables.set('photoId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Feed, search and filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photos?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "groupId",
                  "value": "{{groupId}}",
                  "disabled": true
                },
                {
                  "key": "uploader",
                  "value": "{{username}}",
                  "disabled": true
                },
                {
                  "key": "tag",
                  "value": "sunset",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": true,
                  "description": "YYYY-MM-DD"
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "disabled": true,
                  "description": "YYYY-MM-DD"
                },
                {
                  "key": "q",
                  "value": "postman",
                  "disabled": true,
                  "description": "Keyword in caption or comments"
                },
                {
                  "key": "sort",
                  "value": "newest",
                  "disabled": true,
                  "description": "newest or oldest"
                }
              ]
            },
            "description": "Tick any of the disabled query parameters in the Params tab to filter. They can be combined."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a photos array', () => pm.expect(pm.response.json().photos).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "One photo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photos/{{photoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos",
                "{{photoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photos/{{photoId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos",
                "{{photoId}}",
                "comments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/photos/{{photoId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos",
                "{{photoId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Nice shot from Postman!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Saves the new id into \"commentId\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Nice shot from Postman! (edited)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Owner only. Another user gets 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            },
            "description": "Comment owner or photo owner only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete photo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photos/{{photoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos",
                "{{photoId}}"
              ]
            },
            "description": "Owner only. Removes the row (comments and tag links cascade), then the S3 object. Kept last so the comment requests above still have a photo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
